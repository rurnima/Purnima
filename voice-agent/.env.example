# LiveKit Cloud project credentials (keep these only in the agent host's secret manager)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Gnani Vachana API key for Bengali speech recognition and speech synthesis
GNANI_API_KEY=YOUR_GNANI_API_KEY

# Optional: choose a voice supported by Gnani timbre-v2.5
GNANI_TTS_VOICE=Kaveri
PURNIMA_LLM_MODEL=google/gemma-4-31b-it
